# ── Database (Postgres) ──────────────────────────────────────────────
# In locale: `npm run db:up` avvia Postgres su localhost:5434 e Adminer su localhost:8080
# Credenziali del container (lette da docker-compose.yml): se le cambi, aggiorna anche gli URL sotto
POSTGRES_USER=auth
POSTGRES_PASSWORD=auth
POSTGRES_DB=my_nextauth
DATABASE_URL="postgresql://auth:auth@localhost:5434/my_nextauth"
# Connessione diretta (senza pooler) per le migration. In locale = DATABASE_URL
DIRECT_URL="postgresql://auth:auth@localhost:5434/my_nextauth"

# ── Better Auth ──────────────────────────────────────────────────────
# Genera con: openssl rand -base64 32 (diverso per ogni progetto/ambiente!)
# (oppure: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
BETTER_AUTH_SECRET=""
# URL pubblico dell'app (senza slash finale). In produzione: https://tuodominio.it
BETTER_AUTH_URL="http://localhost:3000"
# Origini aggiuntive fidate, separate da virgola (es. domini di preview). Opzionale
TRUSTED_ORIGINS=""
# Email che ricevono il ruolo ADMIN alla prima registrazione, separate da virgola
AUTH_ADMIN_EMAILS=""
# "on" limita registrazione e login alle email della white list gestita da /admin/allowed-emails.
# Imposta prima AUTH_ADMIN_EMAILS: gli admin di bootstrap sono sempre ammessi.
AUTH_ALLOWLIST=""
# "on" per attivare il rate limit anche in sviluppo (in produzione è sempre attivo)
AUTH_RATE_LIMIT=""
# Header da cui leggere l'IP del client (rate limit). Vercel: x-real-ip
AUTH_IP_HEADERS="x-forwarded-for"

# ── Google OAuth (opzionale: se vuoto il pulsante non compare) ───────
# Redirect URI da registrare su Google Cloud: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Provider OIDC generico (opzionale, es. IBM w3id, Keycloak, Entra) ─
# Attivo solo se ID, DISCOVERY_URL, CLIENT_ID e CLIENT_SECRET sono valorizzati.
# Redirect URI da registrare: {BETTER_AUTH_URL}/api/auth/callback/{OIDC_PROVIDER_ID}
OIDC_PROVIDER_ID=""
OIDC_LABEL="SSO aziendale"
OIDC_DISCOVERY_URL=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_SCOPES="openid profile email"

# ── Email ────────────────────────────────────────────────────────────
# console (dev: stampa in console + .dev-mailbox.jsonl) | resend | sendgrid
EMAIL_PROVIDER="console"
EMAIL_FROM="My App <noreply@example.com>"
RESEND_API_KEY=""
SENDGRID_API_KEY=""

# ── Seed (npm run db:seed) ───────────────────────────────────────────
# Crea un ADMIN con email+password già verificato. Default solo per sviluppo
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin123!"
